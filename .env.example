# TUF configuration. Copy to `.env` for local runs (never commit .env).
# On GitHub Actions put the first four in Secrets and the rest in Variables.
# Full reference: docs/CONFIGURATION.md

# --- Required ---------------------------------------------------------------
# Splitwise personal API key: https://secure.splitwise.com/apps -> Register your application
SPLITWISE_API_KEY=
# Notion internal integration secret: https://www.notion.so/profile/integrations
NOTION_API_KEY=
# URL (or id) of the Notion page you shared with the integration; TUF creates its
# databases and dashboard inside it.
NOTION_ROOT_PAGE_ID=

# --- Optional AI (free tier; see docs/PRIVACY.md before enabling) ------------
# Get a key at https://aistudio.google.com/apikey . Leave empty for rule-based only.
GEMINI_API_KEY=
# AI_ENABLED=true            # defaults to true when GEMINI_API_KEY is set
# GEMINI_MODEL=gemini-3.1-flash-lite
# AI_MAX_REQUESTS_PER_RUN=5
# AI_BATCH_SIZE=20
# AI_MIN_CONFIDENCE=0.6

# --- Money ------------------------------------------------------------------
REPORTING_CURRENCY=USD
MONTHLY_BUDGET=1500
# FX_ENABLED=true            # convert foreign currencies via frankfurter.dev (free, no key)
# BUDGET_AMBER_PCT=75
# BUDGET_RED_PCT=90
TIMEZONE=America/Los_Angeles

# --- Sync -------------------------------------------------------------------
# SYNC_OVERLAP_HOURS=48      # incremental runs re-check this much history
# BACKFILL_START=2024-01-01  # first full import starts here (empty = all history)
# RECONCILE_MAX_REMOVAL_RATIO=0.2

# --- Trips & categories -----------------------------------------------------
# TRIP_GROUP_PATTERN=^\s*(?:trip|travel|vacation)\s*[:\-]\s*(?P<name>.+?)\s*$
# TRIP_AUTO_CREATE=true      # create trips from unknown #hashtags / [bracket] tags
# SUBCATEGORY_MIN_OCCURRENCES=3
# SUBCATEGORY_AUTO_APPROVE=false

# --- Output -----------------------------------------------------------------
# DASHBOARD_CHARTS=true
LOG_LEVEL=INFO
# LOG_FORMAT=text
